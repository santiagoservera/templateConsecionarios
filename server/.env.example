# ── Base de datos ─────────────────────────────────────────────────────────────
# SQL Server connection string
DATABASE_URL="sqlserver://localhost:1433;database=DealerOS;integratedSecurity=true;trustServerCertificate=true"

# Requerida por prisma migrate dev — crear DB vacía con este nombre
SHADOW_DATABASE_URL="sqlserver://localhost:1433;database=DealerOS_shadow;integratedSecurity=true;trustServerCertificate=true"

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET="cambiar-por-clave-secreta-larga-y-aleatoria"
JWT_REFRESH_SECRET="cambiar-por-otra-clave-secreta-diferente"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
CLIENT_URL="http://localhost:5173"
